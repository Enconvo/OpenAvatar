      "type": "felt",
      "color": "#D7A86E",
      "sheen": "#FFFFFF"
    }
  },
  "face": {
    "type": "bead",
    "eyes": {
      "size": 0.08,
      "spacing": 0.3,
      "height": 0.5
    },
    "mouth": {
      "shape": "smile",
      "width": 0.14,
      "height": 0.32
    }
  }
