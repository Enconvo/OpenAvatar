      "conformance"
    ]
  },
  "body": {
    "material": "main",
    "shape": {
      "type": "extrusion",
      "outline": {
        "type": "union",
        "smooth": 0.2,
        "children": [
          {
            "type": "circle",
            "radius": 0.5,
            "center": [
              0,
              0.45
            ]
          },
          {
            "type": "circle",
            "radius": 0.58,
            "center": [
              0,
              -0.38
            ]
          }
        ]
      },
      "depth": 0.8,
      "rounding": 0.28,
      "puff": 0.45
    }
  },
  "materials": {
