{
  "openavatar": "0.1",
  "id": "org.openavatar.conformance.behavior-reactions",
  "name": "Reactions",
  "meta": {
    "license": "CC0-1.0",
    "authors": [
      {
        "name": "OpenAvatar"
      }
    ],
    "tags": [
      "conformance"
    ]
  },
  "body": {
    "material": "main",
    "shape": {
      "type": "sphere",
      "radius": 0.9
    }
  },
  "materials": {
    "main": {
      "type": "felt",
      "color": "#F2C9A0",
      "sheen": "#FFFFFF"
    }
  },
  "face": {
    "type": "bead",
    "eyes": {
      "size": 0.08,
      "spacing": 0.3,
      "height": 0.15
    },
    "mouth": {
      "shape": "smile",
      "width": 0.14,
      "height": -0.08
    },
    "expressions": {
      "x-shy": {
        "eyes": "wide",
        "mouth": "o"
      }
    }
  },
  "behavior": {
    "reactions": {
      "states": {
        "thinking": {
          "expression": "relaxed",
          "effect": "sparkles"
        }
      },
      "activities": {
        "done": {
          "motion": "x-acme-dab",
          "effect": "confetti"
        },
        "error": null
      },
      "userActivities": {
        "coding": {
          "prop": "notebook"
        },
        "listening-music": {
          "prop": null
        },
        "reading": {
          "expression": "x-shy",
          "gaze": "down"
        },
        "writing": {
          "expression": "x-smug"
        }
      }
    }
  }
}
