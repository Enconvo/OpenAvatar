{
  // The gallery. `npm run dev` serves it on this computer; `npm run deploy` builds it for its address and deploys it.
  "name": "openavatar-gallery",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  // The gallery's address; `npm run deploy` builds for it. The workers.dev address is off so links have one home.
  "routes": [{ "pattern": "openavatar.enconvo.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker labels avatar files, lets other apps read them and the list, and takes submissions.
    "run_worker_first": ["/avatars/*", "/api/*"]
  },
  // Submissions waiting for review. Apply new migrations with
  // `npx wrangler d1 migrations apply openavatar-gallery --remote` before deploying the Worker that reads them.
  "d1_databases": [
    { "binding": "DB", "database_name": "openavatar-gallery", "database_id": "fff89056-614a-4b1e-af2c-6f637b4da066", "migrations_dir": "migrations" }
  ],
  // At most five submissions a minute from one address.
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
