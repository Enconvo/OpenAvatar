  "materials": {
    "cream": { "type": "felt", "color": "#F2E4CC", "sheen": "#FFFFFF" },
    "band": { "type": "felt", "color": "#FF7A5E", "sheen": "#FFD3C6" },
    "cup": { "type": "felt", "color": "#F2533F", "sheen": "#FFB8A8", "glow": { "color": "#FF8A6A", "intensity": 1.6, "driver": "listening" } }
