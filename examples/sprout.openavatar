  "parts": [
    {
      "id": "stem", "role": "leaf", "material": "stem",
      "shape": { "type": "capsule", "from": [0, 0, 0], "to": [0, 0.2, 0], "radius": 0.028 },
      "attach": { "direction": [0, 1, 0], "lift": -0.025, "align": "upright" },
      "animations": [{ "type": "sway", "axis": "z", "amount": 3, "speed": 0.2 }]
    },
    {
      "id": "leaves", "role": "leaf", "material": "leaf",
