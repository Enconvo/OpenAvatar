    "material": "lime"
  },
  "materials": {
    "lime": { "type": "felt", "color": "#A2D840" },
    "stem": { "type": "felt", "color": "#3C9A45", "sheen": "#9EE08F" },
    "leaf": { "type": "felt", "color": "#45BC52", "sheen": "#C2F5AE" }
  },
  "face": {
    "eyes": { "size": 0.076, "spacing": 0.23, "height": 0.08 },
    "mouth": { "width": 0.13, "height": -0.14 }
